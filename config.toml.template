# UK Letting Researcher - Configuration
# This file centralizes all configurable parameters for the application.
# Make a copy of this file and rename it to 'config.toml'

[search]
# Your default work or POI location for all commute calculations.
# The default is King's Cross (N1C 4AG)
work_latitude = 51.5349
work_longitude = -0.1238

[scoring.weights]
# The relative importance of each metric when calculating the final Smart Score.
# These will be automatically normalized to sum to 1.0
price = 0.3
commute = 0.3
vibe = 0.3
freshness = 0.1

[scoring.thresholds]
# Maximum acceptable commute time in minutes. Commutes longer than this score 0.
max_commute_mins = 60
# Number of days before a property's freshness score decays to 0.
freshness_decay_days = 7

[cache]
# Number of days before local 'vibe' AI cache is considered stale.
vibe_ttl_days = 30

[api.tfl]
# Minimum seconds between requests to stay within TfL's 50/min free tier.
rate_limit_interval_seconds = 1.5

[api.overpass]
# OpenStreetMap Overpass API Endpoint. 
# openstreetmap.fr is preferred for stability and fewer blocks than the main endpoint.
url = "https://overpass.openstreetmap.fr/api/interpreter"
# Radius in meters to search for local amenities (e.g. gyms, supermarkets).
search_radius_meters = 1000

[api.gemini]
# The Gemini Model to use for evaluating area vibes.
model = "gemini-3.1-flash-lite"
# The system prompt used to instruct Gemini.
prompt_template = """
You are a London property market expert.
Analyze the 'vibe' of the following London locations (postcode districts or full addresses).
Focus on: Safety, target demographic (students, families, professionals), gentrification status, and overall atmosphere.

Respond ONLY with a valid JSON object where keys are the exact location strings provided, and values are objects with:
1. "score": A subjective desirability score from 1-10 (1=terrible, 10=amazing).
2. "summary": A concise 3-5 word description highlighting the dominant traits.
3. "safety": One of ["High", "Medium", "Low"].
4. "keywords": A list of 3 strings (e.g., ["Leafy", "Quiet", "Riverside"]).

Locations to analyze:
{locations}
"""

[network]
# User agent used when scraping property portals.
user_agent = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36"
